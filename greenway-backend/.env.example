# 后端环境变量示例
# 复制此文件为 .env.local 并填入实际值

# ========================================
# 数据库配置
# ========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=greenway
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ========================================
# 服务器配置
# ========================================

PORT=3001
NODE_ENV=development

# ========================================
# CORS 配置
# ========================================

CORS_ORIGIN=http://localhost:5173

# ========================================
# 日志级别
# ========================================

LOG_LEVEL=debug

# ========================================
# AI 助手配置（硅基流动 SiliconFlow）
# 申请地址：https://cloud.siliconflow.cn
# ========================================

SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
AI_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
AI_REQUEST_TIMEOUT=30000
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# ========================================
# JWT 认证密钥（必填）
# 生产环境请使用强随机字符串，例如：openssl rand -hex 32
# ========================================

JWT_SECRET=your_random_jwt_secret_here

# ========================================
# 高德开放平台 Key（天气 / 逆地理 / 地点搜索代理使用）
# 申请地址：https://lbs.amap.com/
# ========================================

GAODE_KEY=your_amap_web_service_key_here

# ========================================
# GeoScene Server 服务地址（可选）
# 格式：https://your-server/rest/services
# 不配置时 /api/geoscene/* 接口返回 503，前端自动降级到本地 GeoJSON 数据源
# ========================================

GEO_SCENE_QUERY_BASE=

# ========================================
# 敏感词库目录（可选，默认指向项目根目录的「敏感词汇表」）
# 目录缺失时评论敏感词过滤自动降级，不影响其他功能
# ========================================

SENSITIVE_WORDS_DIR=
