# 环境变量配置示例
# 复制此文件为 .env.local 并填入你的 API 密钥

# 高德天气 API Key（从高德地图开发平台申请）
# https://lbs.amap.com/
VITE_AMAP_KEY=your_amap_api_key_here

# 百度地图 API Key（从百度地图开放平台申请）
# https://lbsyun.baidu.com/
VITE_BAIDU_MAP_KEY=your_baidu_map_key_here

# 后端 API 地址
VITE_API_BASE_URL=http://localhost:3001

# GeoScene Server 服务地址（可选）
# 格式：https://your-server/rest/services
# 不配置时地图绿道改用后端 /api/greenways 的 GeoJSON 图层渲染（自动降级，开箱可用）
VITE_GEOSCENE_BASE=

# 站点对外访问地址（可选，用于生成二维码与分享链接的绝对地址）
# 不配置时自动取当前浏览器访问域名
VITE_SITE_URL=
